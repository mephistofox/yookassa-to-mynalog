# fxTunnel Go port. Never commit real values. Compose reads this file;
# the binary itself reads environment variables, not dotenv files.
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
MOY_NALOG_AUTH_METHOD=refresh
MOY_NALOG_REFRESH_TOKEN=
# Must be the browser device ID that issued this refresh token.
DEVICE_ID=
MOY_NALOG_RECEIPT_INN=

# REQUIRED: exact cutoff after the last manually issued receipt, with timezone.
# Keep blank until you have reconciled the existing receipts.
SYNC_START_DATE=
STATE_DB=/data/receipts-go.db
INCOME_DESCRIPTION=Доступ к сервису fxTunnel
POLL_INTERVAL=1m
RETRY_INTERVAL=15s
FNS_REQUEST_INTERVAL=1s
REQUEST_TIMEOUT=30s
HEALTH_MAX_AGE=15m
REFUNDS_ENABLED=false

DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional local egress bindings, same purpose as fxTunnel YooKassa SourceIP.
YOOKASSA_SOURCE_IP=
NALOG_SOURCE_IP=
# Bare binary default is loopback; Compose overrides to bind inside container.
HEALTH_LISTEN=0.0.0.0:8099

# Every value also supports NAME_FILE=/run/secrets/... instead of NAME.
# Password login is optional; do not put a Gosuslugi password here.
# MOY_NALOG_AUTH_METHOD=password
# MOY_NALOG_LOGIN=
# MOY_NALOG_PASSWORD=
